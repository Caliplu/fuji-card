# Supabase Configuration
SUPABASE_URL=your_supabase_url
# Backend only; use the new Supabase secret key. Never prefix it with VITE_.
SUPABASE_SECRET_KEY=

# Paystack Configuration
PAYSTACK_PUBLIC_KEY=pk_live_your_public_key_here
PAYSTACK_SECRET_KEY=sk_live_your_secret_key_here
PAYSTACK_CURRENCY=ZAR

# PayFast Configuration
PAYFAST_MERCHANT_ID=your_merchant_id_here
PAYFAST_MERCHANT_KEY=your_merchant_key_here
PAYFAST_PASSPHRASE=your_passphrase_here
PAYFAST_URL=https://www.payfast.co.za/eng/process

# Frontend Configuration
VITE_API_URL=http://localhost:3001/api
VITE_PAYSTACK_PUBLIC_KEY=pk_live_your_public_key_here
PUBLIC_SITE_URL=https://www.fuji-card.com
# Set only after the mailbox has been tested for sending and receiving.
VITE_SUPPORT_EMAIL=
# Optional verified Fuji Card Instagram profile URL; hidden while empty.
VITE_INSTAGRAM_URL=
# Optional order-request channel: enter only a store-owned, tested WhatsApp number
# in international format (digits with country code). Checkout stays disabled when empty.
VITE_ORDER_WHATSAPP_NUMBER=
# Server-side safeguard: enable only after catalog stock/prices and order handling
# have been verified. The website's WhatsApp request is separate from API checkout.
ORDER_PROCESSING_ENABLED=false

# Admin credentials (initial setup only; stored credentials take precedence)
ADMIN_USERNAME=replace_with_admin_username
ADMIN_PASSWORD=replace_with_a_unique_long_password

# Generate a unique random secret of at least 32 characters before starting the API.
JWT_SECRET=
